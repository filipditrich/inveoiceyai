# Neon Postgres (Plan 1+) — pooled URL for runtime
DATABASE_URL=

# Neon direct URL for migrations / drizzle-kit (optional if same as DATABASE_URL locally)
DATABASE_URL_UNPOOLED=

# Public origin for SPAYD templates / emails later
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: development | production | staging | beta | alpha
NEXT_PUBLIC_APP_STAGE=development

# Single default workspace until Clerk auth (Plan 14) — seeded UUID in Neon
INVOICEY_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# UploadThing (Plan 5+) — issuer logo / stamp / signature
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=

# Eve Slack agent (Plan 13b) — apps/web/agent via withEve → /eve/v1/*
# Slack credentials: Vercel Connect (slack/invoicey) → trigger path /eve/v1/slack
# See docs/specs/slack-eve.md (human Connect checklist). Node 24+ required.
# AI_GATEWAY_API_KEY=...   # Vercel AI Gateway (or OIDC on Vercel)
# INVOICEY_AI_MODEL=openai/gpt-4o-mini
# EVE_API_KEY=...          # optional Bearer for HTTP /eve/v1/*; falls back to MCP_API_KEY
# INVOICEY_DEMO_ISSUER_JSON={"id":"...","name":"...",...}  # optional demo IssuerSnapshot
#
# Deprecated for Eve (Plan 13a only): SLACK_BOT_TOKEN / SLACK_SIGNING_SECRET

# MCP (Plan 12a) — local stdio apps/mcp; remote HTTP apps/web /api/mcp
# INVOICEY_PRESETS_PATH=/absolute/path/to/presets.json
# INVOICEY_PRESETS_BACKEND=file   # force JSON file even when DATABASE_URL is set
# Bearer gate for /api/mcp. Optional (the app boots without it) but the route
# rejects every request when unset. Replaced by OAuth in Plan 14.
MCP_API_KEY=

# Auth (Plan 14) — OAuth only, no email+password. See docs/specs/auth.md.
# Generate the secret with: openssl rand -base64 32   (min 32 chars)
BETTER_AUTH_SECRET=
# Defaults to NEXT_PUBLIC_APP_URL when unset.
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# github.com/settings/developers -> OAuth Apps (one app per environment).
# Callback URL: <origin>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
