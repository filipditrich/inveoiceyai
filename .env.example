# Neon Postgres (Plan 1+) — pooled URL for runtime
DATABASE_URL=

# Neon direct URL for migrations / drizzle-kit (optional if same as DATABASE_URL locally)
DATABASE_URL_UNPOOLED=

# Public origin for SPAYD templates / invite + email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Plan 11) — Resend + @invoicey/emails
# Verify invoicey.ditrich.me in Resend; see docs/specs/email.md
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Invoicey <invoices@invoicey.ditrich.me>
EMAIL_SYSTEM_FROM=Invoicey <noreply@invoicey.ditrich.me>
# Bearer for /api/cron/overdue-reminders, recurring-drafts, bank-sync (Plan 11d / 10 / 22)
CRON_SECRET=
# Bank token encryption (Plan 22 Fio) — generate with: openssl rand -base64 32
BANK_TOKEN_ENCRYPTION_KEY_V1=
BANK_TOKEN_ACTIVE_KEY_VERSION=1

# Incoming invoices (Plan 24) — inbound capture via Resend Inbound.
# MX for this subdomain must point at Resend at the lowest priority; the apex
# domain keeps its existing mail setup. See docs/specs/inbound-email-capture.md
INVOICEY_INBOUND_EMAIL_DOMAIN=inbox.invoicey.ditrich.me
# Svix secret for the email.received webhook. Distinct from
# RESEND_WEBHOOK_SECRET, which stays on the delivery-events webhook.
RESEND_INBOUND_WEBHOOK_SECRET=
# Per-attachment and per-workspace capture limits
INVOICEY_INBOUND_MAX_ATTACHMENT_BYTES=20971520
INVOICEY_INBOUND_MAX_MESSAGES_PER_DAY=200
# Document-capable AI Gateway model for invoice extraction (Plan 24c).
# Separate from INVOICEY_AI_MODEL, which stays the drafting model.
INVOICEY_AI_EXTRACT_MODEL=

# Optional: development | production | staging | beta | alpha
NEXT_PUBLIC_APP_STAGE=development

# Single default workspace for machine identities (MCP / Slack / cron) when no session
INVOICEY_DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# Platform admin (Plan 18 / ADR 0024) — comma-separated emails promoted on sign-in
# (promote-only; never auto-demotes). Runtime gates still read users.platform_role.
INVOICEY_PLATFORM_ADMIN_EMAILS=

# UploadThing (Plan 5+) — issuer logo / stamp / signature
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=

# MCP (Plan 12a) — local stdio apps/mcp; remote HTTP apps/web /api/mcp
# INVOICEY_PRESETS_PATH=/absolute/path/to/presets.json
# INVOICEY_PRESETS_BACKEND=file   # force JSON file even when DATABASE_URL is set
# Bearer gate for /api/mcp. Optional (the app boots without it) but the route
# rejects every request when unset. Replaced by OAuth in Plan 14.
MCP_API_KEY=

# Auth (Plan 14) — OAuth only, no email+password. See docs/specs/auth.md.
# Generate the secret with: openssl rand -base64 32   (min 32 chars)
# Required at BUILD time too, not just runtime: `next build` runs with
# NODE_ENV=production, and better-auth refuses to construct with its default
# secret there, so `bun run build` fails without this once a route imports auth.
BETTER_AUTH_SECRET=
# Defaults to NEXT_PUBLIC_APP_URL when unset.
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# github.com/settings/developers -> OAuth Apps (one app per environment).
# Callback URL: <origin>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Eve Slack agent (Plan 13b) — apps/web/agent via withEve → /eve/v1/*
# Slack credentials: Vercel Connect (slack/invoicey) → trigger path /eve/v1/slack
# See docs/specs/slack-eve.md. Node 24+ required.
AI_GATEWAY_API_KEY=
INVOICEY_AI_MODEL=openai/gpt-4o-mini
# Optional Bearer for HTTP /eve/v1/*; falls back to MCP_API_KEY when unset
EVE_API_KEY=
# Optional demo IssuerSnapshot JSON for agent tools
INVOICEY_DEMO_ISSUER_JSON=

# Presets backend (MCP / tools) — Neon when DATABASE_URL is set, else file
INVOICEY_PRESETS_PATH=
# Force JSON file even when DATABASE_URL is set: file
INVOICEY_PRESETS_BACKEND=

# Vercel prod Eve builds
# VERCEL_USE_EXPERIMENTAL_FRAMEWORKS=1

# Deprecated for Eve (Plan 13a only): SLACK_BOT_TOKEN / SLACK_SIGNING_SECRET
