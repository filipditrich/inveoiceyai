{
  "name": "invoicey",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@invoicey/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo run test",
    "email:dev": "bun run --cwd packages/emails email:dev",
    "db:push": "turbo run db:push --filter=@invoicey/db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commit": "cz",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "commitizen": "4.3.2",
    "conventional-changelog-conventionalcommits": "10.3.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "semantic-release": "25.0.9",
    "turbo": "^2.5.6",
    "typescript-eslint": "^8"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "{apps,packages}/**/*.{js,jsx,mjs,cjs,ts,tsx}": "sh scripts/lint-staged.sh"
  },
  "patchedDependencies": {
    "mcp-handler@1.1.0": "patches/mcp-handler@1.1.0.patch"
  },
  "version": "1.2.0",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
